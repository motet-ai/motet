# Local model files (GGUF, etc.)
models/
model_cache/

# ADR-0064 implementation: `motet/core/models/` is source code and must be tracked.
# Note: `models/` above ignores any directory named "models" at any depth, so we explicitly unignore.
!motet/core/models/
!motet/core/models/**
!tests/unit/core/models/
!tests/unit/core/models/**

# Re-ignore caches inside the unignored models subtree
motet/core/models/**/__pycache__/
motet/core/models/**/*.py[cod]
tests/unit/core/models/**/__pycache__/
tests/unit/core/models/**/*.py[cod]
motet/core/models/**/.pytest_cache/
motet/core/models/**/.mypy_cache/

# Node artifacts
node_modules/

# Test bundle repos (local dev only — contain embedded .git directories)
# The old top-level directory is no longer used; bundle sources now live in
# tests/bundles/ (committed) and the initialised repos go in tests/bundles/.repos/
# which is gitignored here.
test_bundles/
tests/bundles/.repos/
tests/bundles/**/__pycache__/
tests/bundles/**/*.py[cod]
/motet/interfaces/frontend/apps/ops-dashboard/.vite/deps
.claude/

# Temporary files
.tmp*