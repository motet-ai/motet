# Motet local development environment template.
# Copy to `.env` and replace placeholder values before running the stack.

# Core services
MOTET_REDIS_URL=redis://localhost:6379/0
MOTET_PURE_DISTRIBUTED_INVOKER_REDIS_URL=redis://localhost:6379/1
MOTET_PGVECTOR_DSN=postgresql://motet:motet_dev@localhost:5432/motet
MOTET_PGVECTOR_TABLE=motet_embeddings

# API and auth
MOTET_API_HOST=0.0.0.0
MOTET_API_PORT=8000
MOTET_REQUIRE_AUTH_FOR_OPS_ENDPOINTS=true
MOTET_ALLOW_INSECURE_PRINCIPAL_HEADERS=false
MOTET_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Vault and encryption
# Generate local values with a password manager or `openssl rand -hex 32`.
MOTET_VAULT_ENABLED=false
MOTET_VAULT_MASTER_KEY=replace-with-local-development-key
MOTET_VAULT_SALT=replace-with-local-development-salt

# Model providers
MOTET_MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
GOOGLE_API_KEY=replace-with-google-api-key

# Feature flags
MOTET_ENABLE_VECTOR_MEMORY=true
MOTET_ENABLE_LLM_TOOL_SELECTION=true
MOTET_ENABLE_SUMMARIZATION=true
MOTET_TRACE_ENABLED=true
MOTET_METRICS_ENABLED=true

# MCP
MCP_INSTANCE_MANAGER_CONFIG=config/mcp_instance_manager.yaml
PLAYWRIGHT_HEADLESS=true

# Development
MOTET_DEBUG_MODE=false
MOTET_LOG_LEVEL=INFO
MOTET_RATE_LIMIT_PER_MINUTE=300

# Convenience images for pull-first `motet-cli local up`.
# Public ghcr.io/motet-ai images pull without login. Login only for a private/eval registry.
# `--build` still rebuilds from this tree.
MOTET_IMAGE_REGISTRY=ghcr.io/motet-ai
MOTET_IMAGE_TAG=v0.1.1
